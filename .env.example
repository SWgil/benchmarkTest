# Ollama 서버의 OpenAI 호환 엔드포인트 (끝에 /v1 포함)
OLLAMA_BASE_URL=http://10.251.36.222:9090/v1
# Ollama는 API 키를 검사하지 않지만 openai 클라이언트가 빈 값을 허용하지 않음
OLLAMA_API_KEY=ollama
# Ollama 모델 태그. Phase 0에서 `ollama list` / /api/tags 로 확정
OLLAMA_MODEL=qwen3.8:27b
# 공격 문구에서 모델을 지칭할 때 쓰는 이름 (논문의 "GPT-4", "Claude"에 해당)
MODEL_PROSE_NAME=Qwen

# ---- AutoDojo 2단계(최적화) 전용. scripts/run_autodojo_optimize.sh 가 OLLAMA_* 로부터 자동 설정하므로 보통 비워 둔다.
# LOCAL_LLM_REASONING_EFFORT=none   # 타깃 모델 thinking off (Ollama: "none" -> think=false)
# OLLAMA_REASONING_EFFORT=          # 최적화(analyzer/rewriter) LLM. 비우면 모델 기본값(thinking on)
# OPTIMIZER_MODEL=qwen3.8:27b       # 최적화 LLM 태그. 비우면 타깃과 같은 모델
