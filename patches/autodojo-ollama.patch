+def _local_llm_base_url(port_env: str = "LOCAL_LLM_PORT", default_port: int = 8000) -> str:
+    """Base URL of the local OpenAI-compatible target server.
+
+    ``LOCAL_LLM_BASE_URL`` (e.g. ``http://10.251.36.222:9090/v1`` for a remote Ollama)
+    takes precedence; otherwise ``http://localhost:$LOCAL_LLM_PORT/v1``.
+    """
+    explicit = os.getenv("LOCAL_LLM_BASE_URL")
+    if explicit:
+        return explicit.rstrip("/")
+    port = os.getenv(port_env, default_port)
+    return f"http://localhost:{port}/v1"
+
+
+def _get_local_model_id(port, base_url: str | None = None) -> str:
+    """Served model id. ``LOCAL_LLM_MODEL_ID`` wins (required when the server hosts
+    several models, e.g. Ollama); otherwise the first entry of ``/v1/models``."""
+    explicit = os.getenv("LOCAL_LLM_MODEL_ID")
+    if explicit:
+        logging.info(f"Using model from LOCAL_LLM_MODEL_ID: {explicit}")
+        return explicit
+    url = f"{base_url.rstrip('/') if base_url else f'http://localhost:{port}/v1'}/models"
